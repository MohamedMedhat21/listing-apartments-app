# Copy this file to .env before running `docker compose up`.
# No real secrets belong in this file; every value below is a safe local default.

# ---------------------------------------------------------------------------
# Database (consumed by the postgres container and by apps/api)
# ---------------------------------------------------------------------------
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=apartments
POSTGRES_USER=apartments
POSTGRES_PASSWORD=apartments_dev_password

# ---------------------------------------------------------------------------
# apps/api
# ---------------------------------------------------------------------------
NODE_ENV=development
API_PORT=4000

# Comma-separated list of origins allowed to call the API from the browser.
CORS_ORIGIN=http://localhost:3000

# JWT access token. JWT_SECRET must be overridden with a long random value
# outside local development; there is no default checked into this file.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1h

# Rate limiting: global and login-specific (requirements.md section 9).
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100
THROTTLE_LOGIN_TTL_MS=60000
THROTTLE_LOGIN_LIMIT=5

# Seeded ADMIN account (requirements.md section 5.4). Change the password
# outside local development.
ADMIN_EMAIL=admin@nawy.local
ADMIN_PASSWORD=change-me-too

# ---------------------------------------------------------------------------
# apps/web
# ---------------------------------------------------------------------------
WEB_PORT=3000

# Base URL the browser uses to call the API directly (search, mutations, login).
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Base URL apps/web uses for server-side (Server Component) fetches over the
# internal Docker network. Falls back to NEXT_PUBLIC_API_URL outside Docker.
INTERNAL_API_URL=http://api:4000/api/v1
